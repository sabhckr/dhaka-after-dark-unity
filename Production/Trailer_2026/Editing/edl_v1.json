    {"t": 0.6, "d": 5.6, "style": "small", "text": "Concept visualisation built from in-development DHAKA: AFTER DARK renders. Lighting, neon, rain and reflections are artistic additions, not gameplay."},
    {"t": 4.9, "d": 3.6, "style": "narr", "text": "ঢাকা কখনো ঘুমায় না..."},
    {"t": 12.0, "d": 4.3, "style": "narr", "text": "দিনের আলোয় এই শহরকে চেনা যায়।"},
    {"t": 17.5, "d": 2.3, "style": "card", "text": "ONE CITY."},
    {"t": 25.0, "d": 3.0, "style": "narr", "text": "কিন্তু অন্ধকার নামলে..."},
    {"t": 35.0, "d": 4.0, "style": "narr", "text": "প্রতিটি রাস্তার গল্প বদলে যায়।"},
    {"t": 41.6, "d": 3.0, "style": "card", "text": "A THOUSAND STORIES."},
    {"t": 48.0, "d": 3.2, "style": "narr", "text": "কিছু মানুষ হারিয়ে যায়।"},
    {"t": 57.0, "d": 4.0, "style": "narr", "text": "কিছু মানুষ হারানোর ভয়ে বাঁচে।"},
    {"t": 67.4, "d": 2.5, "style": "card", "text": "EVERY STREET HAS A SECRET."},
    {"t": 68.0, "d": 1.8, "style": "narr", "text": "আর কেউ কেউ..."},
